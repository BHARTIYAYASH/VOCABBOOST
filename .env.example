# Supabase (cloud sync + auth) — https://supabase.com/dashboard → Project Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# AI provider defaults (users can override with their own key inside the app)
# Providers: openrouter | gemini | groq | openai
VITE_AI_PROVIDER=openrouter
VITE_OPENROUTER_KEY=

# Google OAuth client id (secret lives in the Supabase dashboard, never here)
VITE_GOOGLE_CLIENT_ID=
